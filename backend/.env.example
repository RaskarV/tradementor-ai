# ---- app ----
APP_ENV=development
PUBLIC_BASE_URL=                      # https URL of this backend, e.g. https://tradementor.up.railway.app (empty = don't register webhook)
DASHBOARD_ORIGIN=http://localhost:3000

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=                   # from @BotFather
TELEGRAM_WEBHOOK_SECRET=              # 16+ chars of A-Z a-z 0-9 _ -   (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
ADMIN_TELEGRAM_IDS=                   # comma-separated numeric IDs that receive alerts and may use /tickets /assign /reply /close

# ---- data ----
DATABASE_URL=                         # postgresql+asyncpg://postgres.<ref>:<password>@<pooler-host>:6543/postgres
REDIS_URL=redis://localhost:6379/0

# ---- AI ----
LLM_PROVIDER=claude                   # claude | openai
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5        # confirm the exact model id in the Anthropic console
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- embeddings (Claude has no embeddings API) ----
EMBEDDING_PROVIDER=voyage             # voyage | openai
EMBEDDING_MODEL=                      # blank = voyage-3 / text-embedding-3-small
EMBEDDING_DIM=1024                    # must match the vector column; changing it later needs a migration + rebuild
VOYAGE_API_KEY=

# ---- security / limits ----
JWT_SECRET=                           # 32+ random chars
JWT_TTL_MINUTES=480
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=20
RETENTION_DAYS=365
